@@ -0,0 +1,174 @@
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+
+const mock = vi.hoisted(() => ({
+  storage: new Map<string, string>(),
+  listeners: new Set<() => void>(),
+  native: {
+    supported: true,
+    enabled: true,
+    permission: true,
+    installationId: "6b3d6928-30e6-43c0-a6a2-15c109e77451",
+    token: "huawei-only-token",
+    foreground: true,
+    error: "",
+  },
+}));
+vi.mock("@react-native-async-storage/async-storage", () => ({
+  default: {
+    getItem: vi.fn(async (key: string) => mock.storage.get(key) ?? null),
+    setItem: vi.fn(async (key: string, value: string) => {
+      mock.storage.set(key, value);
+    }),
+  },
+}));
+vi.mock("./harmony-bridge", () => ({
+  getHarmonyStatus: vi.fn(async () => mock.native),
+  subscribeHarmonyChange: (listener: () => void) => {
+    mock.listeners.add(listener);
+    return () => mock.listeners.delete(listener);
+  },
+}));
+import {
+  startHarmonySubscription,
+  setHarmonySubscription,
+  revokeHarmonySubscription,
+  getHarmonySubscription,
+} from "./harmony-subscriptions";
+import { getHarmonyStatus } from "./harmony-bridge";
+const flush = async () => {
+  for (let i = 0; i < 40; i++) await Promise.resolve();
+};
+function connection() {
+  let connected = true;
+  let listener = () => {};
+  const rpc = vi.fn(async () => ({ ready: true, message: "ready" }));
+  const client = {
+    get isConnected() {
+      return connected;
+    },
+    invokePluginRpc: rpc,
+    subscribeConnectionStatus: (fn: () => void) => {
+      listener = fn;
+      return () => {
+        listener = () => {};
+      };
+    },
+  } as unknown as DaemonClient;
+  return {
+    client,
+    rpc,
+    change(value: boolean) {
+      connected = value;
+      listener();
+    },
+  };
+}
+beforeEach(() => {
+  vi.useFakeTimers();
+  mock.storage.clear();
+  mock.listeners.clear();
+  mock.native.permission = true;
+  mock.native.token = "huawei-only-token";
+  mock.native.foreground = true;
+});
+afterEach(() => vi.useRealTimers());
+
+it("does not re-register a revoked device when a token refresh was already pending", async () => {
+  const { client, rpc } = connection();
+  const input = { client, serverId: "race-host" };
+  mock.storage.set("@paseo:harmony-push:race-host", JSON.stringify({ enabled: true }));
+  let complete!: (value: typeof mock.native) => void;
+  vi.mocked(getHarmonyStatus).mockImplementationOnce(
+    () =>
+      new Promise((resolve) => {
+        complete = resolve;
+      }),
+  );
+  const stop = startHarmonySubscription(input);
+  try {
+    await flush();
+    await revokeHarmonySubscription(input);
+    rpc.mockClear();
+    complete(mock.native);
+    await flush();
+    expect(rpc).not.toHaveBeenCalledWith("harmonyos-push", "device.register", expect.anything());
+    expect(getHarmonySubscription("race-host")?.enabled).toBe(false);
+  } finally {
+    stop();
+  }
+});
+
+it("requires per-host opt-in, updates rotated tokens/background state, and renews on reconnect", async () => {
+  const { client, rpc, change } = connection();
+  const input = { client, serverId: "test-host" };
+  const stop = startHarmonySubscription(input);
+  try {
+    await flush();
+    expect(rpc).not.toHaveBeenCalled();
+    await setHarmonySubscription(input, true);
+    expect(rpc).toHaveBeenCalledWith(
+      "harmonyos-push",
+      "device.register",
+      expect.objectContaining({
+        token: "huawei-only-token",
+        serverId: "test-host",
+        foreground: true,
+      }),
+    );
+    mock.native.token = "rotated-token";
+    mock.native.foreground = false;
+    mock.listeners.forEach((listener) => listener());
+    await flush();
+    expect(rpc).toHaveBeenLastCalledWith(
+      "harmonyos-push",
+      "device.register",
+      expect.objectContaining({ token: "rotated-token", foreground: false }),
+    );
+    change(false);
+    await flush();
+    rpc.mockClear();
+    change(true);
+    await flush();
+    expect(rpc).toHaveBeenCalledWith("harmonyos-push", "device.register", expect.anything());
+    mock.native.permission = false;
+    mock.listeners.forEach((listener) => listener());
+    await flush();
+    expect(rpc).toHaveBeenLastCalledWith("harmonyos-push", "device.revoke", {
+      installationId: mock.native.installationId,
+    });
+    expect(getHarmonySubscription("test-host")?.message).toContain("通知权限已关闭");
+  } finally {
+    stop();
+  }
+});
+
+it("persists offline revocation and retries it on reconnect without affecting other hosts", async () => {
+  const { client, rpc, change } = connection();
+  const input = { client, serverId: "offline-host" };
+  const stop = startHarmonySubscription(input);
+  try {
+    await flush();
+    await setHarmonySubscription(input, true);
+    change(false);
+    await flush();
+    rpc.mockClear();
+    await revokeHarmonySubscription(input);
+    expect(rpc).not.toHaveBeenCalled();
+    expect(JSON.parse(mock.storage.get("@paseo:harmony-push:offline-host")!)).toEqual({
+      enabled: false,
+      revoke: true,
+    });
+    change(true);
+    await flush();
+    expect(rpc).toHaveBeenLastCalledWith("harmonyos-push", "device.revoke", {
+      installationId: mock.native.installationId,
+    });
+    expect(JSON.parse(mock.storage.get("@paseo:harmony-push:offline-host")!)).toEqual({
+      enabled: false,
+    });
+    expect(mock.storage.has("@paseo:harmony-push:other-host")).toBe(false);
+  } finally {
+    stop();
+  }
+});
diff --git a/packages/app/src/push-notifications/harmony-subscriptions.ts b/packages/app/src/push-notifications/harmony-subscriptions.ts
new file mode 100644
index 000000000..3c8057f8d
--- /dev/null
+++ b/packages/app/src/push-notifications/harmony-subscriptions.ts
@@ -0,0 +1,194 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { z } from "zod";
+import { getHarmonyStatus, subscribeHarmonyChange } from "./harmony-bridge";
+import type { RevokePushNotificationsInput, StartPushNotificationsInput } from "./internal/types";
+
+const PLUGIN = "harmonyos-push";
+const key = (id: string) => `@paseo:harmony-push:${id}`;
+const Preference = z.object({ enabled: z.boolean(), revoke: z.boolean().default(false) });
+const Result = z.object({ ready: z.boolean(), message: z.string() });
+export interface HarmonySubscriptionState {
+  enabled: boolean;
+  message: string;
+}
+const states = new Map<string, HarmonySubscriptionState>();
+const listeners = new Set<() => void>();
+const sessions = new Map<string, () => Promise<void>>();
+const revisions = new Map<string, number>();
+function currentRevision(serverId: string) {
+  return revisions.get(serverId) ?? 0;
+}
+function revise(serverId: string) {
+  const value = currentRevision(serverId) + 1;
+  revisions.set(serverId, value);
+  return value;
+}
+
+function publish(serverId: string, enabled: boolean, message: string) {
+  states.set(serverId, { enabled, message });
+  listeners.forEach((listener) => listener());
+}
+export function subscribeHarmonySubscription(listener: () => void) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+export function getHarmonySubscription(serverId: string) {
+  return states.get(serverId);
+}
+async function read(serverId: string) {
+  try {
+    return Preference.parse(JSON.parse((await AsyncStorage.getItem(key(serverId))) ?? "null"));
+  } catch {
+    return { enabled: false, revoke: false };
+  }
+}
+function problem(error: unknown) {
+  // RPC errors may contain a vendor response; only known local messages reach the UI.
+  if (
+    error instanceof Error &&
+    /^(系统通知|通知权限|Push Kit|设备与|获取华为|仅鸿蒙|无法开启)/.test(error.message)
+  )
+    return error.message;
+  return "主机推送服务不可用，请确认已安装并启用 HarmonyOS Push 插件后重试。";
+}
+
+export function startHarmonySubscription(input: StartPushNotificationsInput): () => void {
+  let stopped = false;
+  let running = false;
+  let again = false;
+  const sync = async () => {
+    if (stopped) return;
+    if (running) {
+      again = true;
+      return;
+    }
+    running = true;
+    const revision = currentRevision(input.serverId);
+    const isCurrent = () => !stopped && revision === currentRevision(input.serverId);
+    try {
+      const preference = await read(input.serverId);
+      if (!isCurrent()) return;
+      publish(
+        input.serverId,
+        preference.enabled,
+        input.client.isConnected ? "" : "等待主机连接后同步通知设置。",
+      );
+      if (!input.client.isConnected || (!preference.enabled && !preference.revoke)) return;
+      const status = await getHarmonyStatus();
+      if (!isCurrent()) return;
+      if (!preference.enabled || !status.permission) {
+        await input.client.invokePluginRpc(PLUGIN, "device.revoke", {
+          installationId: status.installationId,
+        });
+        if (!preference.enabled)
+          await AsyncStorage.setItem(key(input.serverId), JSON.stringify({ enabled: false }));
+        else
+          publish(
+            input.serverId,
+            true,
+            "通知权限已关闭，请在系统通知设置中允许 Paseo。其他设备不受影响。",
+          );
+        return;
+      }
+      if (!status.token) throw new Error(status.error || "获取华为推送令牌失败，请重新开启通知。");
+      const result = Result.parse(
+        await input.client.invokePluginRpc(PLUGIN, "device.register", {
+          installationId: status.installationId,
+          serverId: input.serverId,
+          token: status.token,
+          foreground: status.foreground,
+        }),
+      );
+      if (isCurrent()) publish(input.serverId, true, result.message);
+    } catch (error) {
+      if (!stopped) publish(input.serverId, (await read(input.serverId)).enabled, problem(error));
+    } finally {
+      running = false;
+      if (again && !stopped) {
+        again = false;
+        void sync();
+      }
+    }
+  };
+  const onChange = () => {
+    void sync();
+  };
+  sessions.set(input.serverId, sync);
+  const unsubscribe = input.client.subscribeConnectionStatus(onChange);
+  const removeNative = subscribeHarmonyChange(onChange);
+  const timer = setInterval(onChange, 25_000);
+  onChange();
+  return () => {
+    stopped = true;
+    unsubscribe();
+    removeNative();
+    clearInterval(timer);
+    if (sessions.get(input.serverId) === sync) sessions.delete(input.serverId);
+  };
+}
+
+export async function setHarmonySubscription(
+  input: StartPushNotificationsInput,
+  enabled: boolean,
+): Promise<void> {
+  const revision = revise(input.serverId);
+  if (enabled) {
+    if (!input.client.isConnected) throw new Error("请先连接此主机。");
+    const service = Result.parse(await input.client.invokePluginRpc(PLUGIN, "service.status", {}));
+    if (!service.ready) throw new Error(service.message);
+    const native = await getHarmonyStatus(true);
+    if (revision !== revisions.get(input.serverId)) throw new Error("通知设置已更改，请重新操作。");
+    if (!native.permission || !native.token)
+      throw new Error(native.error || "通知权限未开启，请允许 Paseo 发送通知。");
+    const result = Result.parse(
+      await input.client.invokePluginRpc(PLUGIN, "device.register", {
+        installationId: native.installationId,
+        serverId: input.serverId,
+        token: native.token,
+        foreground: native.foreground,
+      }),
+    );
+    if (!result.ready) throw new Error(result.message);
+  }
+  if (revision !== revisions.get(input.serverId)) throw new Error("通知设置已更改，请重新操作。");
+  await AsyncStorage.setItem(key(input.serverId), JSON.stringify({ enabled, revoke: !enabled }));
+  publish(
+    input.serverId,
+    enabled,
+    enabled ? "通知已开启。" : "通知已关闭。离线主机将在重连后注销此设备。",
+  );
+  await sessions.get(input.serverId)?.();
+}
+
+export async function revokeHarmonySubscription(
+  input: RevokePushNotificationsInput,
+): Promise<void> {
+  revise(input.serverId);
+  // Persist pending revocation before an offline host is removed. It can expire on
+  // the daemon, or be revoked immediately if this host is added again.
+  await AsyncStorage.setItem(key(input.serverId), JSON.stringify({ enabled: false, revoke: true }));
+  publish(input.serverId, false, "通知已关闭。");
+  if (!input.client?.isConnected) return;
+  try {
+    const native = await getHarmonyStatus();
+    await input.client.invokePluginRpc(PLUGIN, "device.revoke", {
+      installationId: native.installationId,
+    });
+    await AsyncStorage.setItem(key(input.serverId), JSON.stringify({ enabled: false }));
+  } catch {
+    /* The daemon's lease expires even if this host never reconnects. */
+  }
+}
+
+export async function testHarmonyNotification(input: StartPushNotificationsInput): Promise<string> {
+  const native = await getHarmonyStatus();
+  const result = Result.parse(
+    await input.client.invokePluginRpc(PLUGIN, "device.test", {
+      installationId: native.installationId,
+    }),
+  );
+  if (!result.ready) throw new Error(result.message);
+  return "华为已接受测试通知，请检查通知中心；实际送达以设备显示为准。";
+}
