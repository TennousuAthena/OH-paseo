+// @vitest-environment jsdom
+import { beforeEach, expect, it, vi } from "vitest";
+import type { NotificationTap } from "./source";
+
+const native = vi.hoisted(() => ({
+  tap: null as NotificationTap | null,
+  listeners: new Set<() => void>(),
+}));
+vi.mock("@/constants/platform", () => ({ isWeb: true }));
+vi.mock("@/push-notifications/harmony-bridge", () => ({
+  harmonyRequest: vi.fn(async () => null),
+  takeHarmonyTap: vi.fn(async () => native.tap),
+  subscribeHarmonyChange: (listener: () => void) => {
+    native.listeners.add(listener);
+    return () => native.listeners.delete(listener);
+  },
+}));
+import { harmonyRequest } from "@/push-notifications/harmony-bridge";
+import { createNotificationOpenSource } from "./source.web";
+import { createNotificationOpenRouter, WEB_NOTIFICATION_CLICK_EVENT } from "./model";
+const flush = async () => {
+  for (let i = 0; i < 15; i++) await Promise.resolve();
+};
+beforeEach(() => {
+  native.tap = null;
+  native.listeners.clear();
+  vi.clearAllMocks();
+});
+
+it("keeps a cold native tap pending until navigation is ready, then acknowledges it", async () => {
+  native.tap = { id: "harmony:cold", data: { serverId: "host", agentId: "agent" } };
+  let ready!: () => void;
+  const wait = new Promise<void>((resolve) => {
+    ready = resolve;
+  });
+  const openAgent = vi.fn();
+  const router = createNotificationOpenRouter({
+    source: createNotificationOpenSource(),
+    openAgent,
+    openRoute: vi.fn(),
+    openTerminal: vi.fn(),
+    whenReadyToNavigate: () => wait,
+  });
+  const stop = router.start();
+  try {
+    await flush();
+    expect(openAgent).not.toHaveBeenCalled();
+    expect(harmonyRequest).not.toHaveBeenCalled();
+    ready();
+    await flush();
+    expect(openAgent).toHaveBeenCalledExactlyOnceWith({ serverId: "host", agentId: "agent" });
+    expect(harmonyRequest).toHaveBeenCalledExactlyOnceWith("ackTap", "harmony:cold");
+  } finally {
+    stop();
+  }
+});
+
+it("deduplicates warm native taps and releases the native subscription", async () => {
+  const openAgent = vi.fn();
+  const router = createNotificationOpenRouter({
+    source: createNotificationOpenSource(),
+    openAgent,
+    openRoute: vi.fn(),
+    openTerminal: vi.fn(),
+    whenReadyToNavigate: async () => {},
+  });
+  const stop = router.start();
+  await flush();
+  native.tap = { id: "harmony:warm", data: { serverId: "host-2", agentId: "agent-2" } };
+  native.listeners.forEach((listener) => listener());
+  native.listeners.forEach((listener) => listener());
+  await flush();
+  stop();
+  expect(openAgent).toHaveBeenCalledExactlyOnceWith({ serverId: "host-2", agentId: "agent-2" });
+  expect(harmonyRequest).toHaveBeenCalledExactlyOnceWith("ackTap", "harmony:warm");
+  expect(native.listeners.size).toBe(0);
+});
+
+it("preserves ordinary web notification clicks and removes their event listener", async () => {
+  const onTap = vi.fn();
+  const stop = createNotificationOpenSource().subscribe(onTap);
+  const click = new CustomEvent(WEB_NOTIFICATION_CLICK_EVENT, {
+    cancelable: true,
+    detail: { data: { serverId: "web-host" } },
+  });
+  window.dispatchEvent(click);
+  stop();
+  window.dispatchEvent(click);
+  expect(click.defaultPrevented).toBe(true);
+  expect(onTap).toHaveBeenCalledTimes(1);
+  expect(harmonyRequest).not.toHaveBeenCalled();
+});
