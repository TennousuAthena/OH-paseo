@@ -0,0 +1,144 @@
+import { useCallback, useEffect, useState } from "react";
+import { Text, View } from "react-native";
+import { useHosts, useHostRuntimeClient, useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+import type { HostProfile } from "@/types/host-connection";
+import { Button } from "@/components/ui/button";
+import { Switch } from "@/components/ui/switch";
+import { Alert } from "@/components/ui/alert";
+import { SettingsSection } from "@/components/settings/headings/settings-section";
+import { settingsStyles } from "@/styles/settings";
+import { getHarmonyStatus, subscribeHarmonyChange } from "./harmony-bridge";
+import {
+  getHarmonySubscription,
+  subscribeHarmonySubscription,
+  setHarmonySubscription,
+  testHarmonyNotification,
+  revokeHarmonySubscription,
+} from "./harmony-subscriptions";
+
+function HostNotifications({ host }: { host: HostProfile }) {
+  const client = useHostRuntimeClient(host.serverId);
+  const connected = useHostRuntimeIsConnected(host.serverId);
+  const [, update] = useState(0);
+  const [pending, setPending] = useState(false);
+  const [message, setMessage] = useState("");
+  const [failed, setFailed] = useState(false);
+  useEffect(() => subscribeHarmonySubscription(() => update((value) => value + 1)), []);
+  const state = getHarmonySubscription(host.serverId);
+  const run = useCallback(
+    async (action: "enable" | "disable" | "test") => {
+      if (pending) return;
+      setPending(true);
+      setMessage("");
+      setFailed(false);
+      try {
+        if (action === "disable")
+          await revokeHarmonySubscription({ client, serverId: host.serverId });
+        else {
+          if (!client) throw new Error("请先连接此主机。");
+          const input = { client, serverId: host.serverId };
+          if (action === "test") setMessage(await testHarmonyNotification(input));
+          else await setHarmonySubscription(input, true);
+        }
+      } catch (error) {
+        setFailed(true);
+        setMessage(error instanceof Error ? error.message : "操作失败，请重试。");
+      } finally {
+        setPending(false);
+      }
+    },
+    [client, pending, host.serverId],
+  );
+  const changeEnabled = useCallback(
+    (enabled: boolean) => {
+      void run(enabled ? "enable" : "disable");
+    },
+    [run],
+  );
+  const sendTest = useCallback(() => {
+    void run("test");
+  }, [run]);
+  return (
+    <View style={settingsStyles.card}>
+      <View style={settingsStyles.row}>
+        <View style={settingsStyles.rowContent}>
+          <Text style={settingsStyles.rowTitle}>{host.label}</Text>
+          <Text style={settingsStyles.rowHint}>
+            {state?.message || (connected ? "开启此主机的任务完成和确认提醒。" : "等待主机连接。")}
+          </Text>
+        </View>
+        <Switch
+          value={state?.enabled ?? false}
+          onValueChange={changeEnabled}
+          disabled={pending || (!connected && !state?.enabled)}
+          accessibilityLabel={`${host.label} 消息推送`}
+        />
+      </View>
+      <View style={[settingsStyles.row, settingsStyles.rowBorder]}>
+        <Text style={settingsStyles.rowHint}>
+          {pending ? "正在处理…" : "通过华为推送服务发送至本设备。"}
+        </Text>
+        <Button
+          variant="outline"
+          size="sm"
+          disabled={!connected || !state?.enabled || pending}
+          onPress={sendTest}
+        >
+          发送测试通知
+        </Button>
+      </View>
+      {message ? (
+        <Alert
+          size="sm"
+          variant={failed ? "error" : "success"}
+          title={failed ? "通知设置未完成" : "测试通知"}
+          description={message}
+        />
+      ) : null}
+    </View>
+  );
+}
+
+export function HarmonyNotificationsSection() {
+  const hosts = useHosts();
+  const [status, setStatus] = useState("正在检查系统通知权限…");
+  useEffect(() => {
+    let active = true;
+    const refresh = () => {
+      void getHarmonyStatus()
+        .then((value) => {
+          if (active)
+            setStatus(
+              value.error ||
+                (value.permission
+                  ? "系统通知权限已允许。"
+                  : "开启主机通知时，将请求系统通知权限。"),
+            );
+          return undefined;
+        })
+        .catch(() => {
+          if (active) setStatus("系统通知服务暂不可用，请重新进入此页。");
+        });
+    };
+    refresh();
+    const remove = subscribeHarmonyChange(refresh);
+    return () => {
+      active = false;
+      remove();
+    };
+  }, []);
+  return (
+    <SettingsSection title="鸿蒙消息推送">
+      <Text style={settingsStyles.rowHint}>
+        应用退到后台或锁屏后，接收任务完成和需要确认的提醒。点击通知可回到对应会话。通知不包含对话内容。
+      </Text>
+      <Text style={settingsStyles.rowHint}>{status}</Text>
+      {hosts.map((host) => (
+        <HostNotifications key={host.serverId} host={host} />
+      ))}
+      {hosts.length === 0 ? (
+        <Text style={settingsStyles.rowHint}>添加并连接主机后，可为此设备开启消息推送。</Text>
+      ) : null}
+    </SettingsSection>
+  );
+}
