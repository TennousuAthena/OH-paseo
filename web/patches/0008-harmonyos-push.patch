diff --git a/packages/app/src/push-notifications/harmony-bridge.ts b/packages/app/src/push-notifications/harmony-bridge.ts
new file mode 100644
index 000000000..667ae8572
--- /dev/null
+++ b/packages/app/src/push-notifications/harmony-bridge.ts
@@ -0,0 +1,61 @@
+import { z } from "zod";
+import { isHarmonyApp } from "@/constants/platform";
+
+export const HarmonyStatusSchema = z.object({
+  supported: z.boolean(),
+  enabled: z.boolean(),
+  permission: z.boolean(),
+  installationId: z.string().min(1),
+  token: z.string(),
+  foreground: z.boolean(),
+  error: z.string(),
+});
+export type HarmonyStatus = z.infer<typeof HarmonyStatusSchema>;
+export const HarmonyTapSchema = z.object({
+  id: z.string().min(1),
+  data: z.object({ serverId: z.string().min(1), agentId: z.string() }),
+});
+
+export function harmonyRequest(
+  action: "status" | "enable" | "takeTap" | "ackTap",
+  tap?: string,
+): Promise<unknown> {
+  if (!isHarmonyApp) return Promise.reject(new Error("仅鸿蒙原生客户端支持此功能。"));
+  return new Promise((resolve, reject) => {
+    const id = crypto.randomUUID();
+    const cleanup = () => {
+      clearTimeout(timeout);
+      window.removeEventListener("paseo-push-result", receive);
+    };
+    const receive = (event: Event) => {
+      if (!(event instanceof CustomEvent) || event.detail?.id !== id) return;
+      cleanup();
+      resolve(event.detail.data);
+    };
+    const timeout = setTimeout(() => {
+      cleanup();
+      reject(new Error("系统通知服务响应超时，请重试。"));
+    }, 30_000);
+    window.addEventListener("paseo-push-result", receive);
+    window.location.assign(
+      `paseo://app/__native/push?id=${id}&action=${action}${tap ? `&tap=${encodeURIComponent(tap)}` : ""}`,
+    );
+  });
+}
+
+export async function getHarmonyStatus(enable = false): Promise<HarmonyStatus> {
+  return HarmonyStatusSchema.parse(await harmonyRequest(enable ? "enable" : "status"));
+}
+
+export function subscribeHarmonyChange(listener: () => void): () => void {
+  if (!isHarmonyApp) return () => {};
+  window.addEventListener("paseo-push-change", listener);
+  return () => window.removeEventListener("paseo-push-change", listener);
+}
+
+export async function takeHarmonyTap() {
+  if (!isHarmonyApp) return null;
+  const value = await harmonyRequest("takeTap");
+  const result = HarmonyTapSchema.safeParse(value);
+  return result.success ? result.data : null;
+}
