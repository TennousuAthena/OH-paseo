+// ArkWeb treats unregistered schemes as opaque URLs. Parse endpoint authorities
+// through a standard scheme; choose one that preserves an explicit port 80.
+function endpointUrlInput(input: string, scheme: "tcp" | "relay"): string {
+  const prefix = new RegExp(`^${scheme}://`, "i");
+  if (!prefix.test(input)) throw new Error(`Invalid ${scheme} connection URI`);
+  const authority = input.slice(input.indexOf("//") + 2).split(/[/?#]/, 1)[0];
+  const transport = /:0*80$/.test(authority) ? "https:" : "http:";
+  return input.replace(new RegExp(`^${scheme}:`, "i"), transport);
+}
+
+function parseEndpointUri(input: string, scheme: "tcp" | "relay"): URL {
+  return new URL(endpointUrlInput(input, scheme));
+}
+
+function serializeEndpointUrl(url: URL): string {
+  return url
+    .toString()
+    .replace(/^https?:/, "tcp:")
+    .replace(/\/(?=[?#]|$)/, "");
+}
