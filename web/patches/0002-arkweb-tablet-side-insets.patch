diff --git a/packages/app/src/hooks/use-workspace-safe-area-insets.ts b/packages/app/src/hooks/use-workspace-safe-area-insets.ts
new file mode 100644
index 000000000..32cb78209
--- /dev/null
+++ b/packages/app/src/hooks/use-workspace-safe-area-insets.ts
@@ -0,0 +1,11 @@
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { isArkWebTablet } from "@/constants/platform";
+
+/** Keep system bar insets while allowing the tablet workspace to reach both side edges. */
+export function useWorkspaceSafeAreaInsets() {
+  const insets = useSafeAreaInsets();
+  // ArkWeb exposes the MatePad side camera as a full-height 18px CSS inset.
+  // The workspace already has internal control spacing; offsetting its entire
+  // shell creates a blank strip beside the sidebar when the tablet rotates.
+  return isArkWebTablet ? { ...insets, left: 0, right: 0 } : insets;
+}
