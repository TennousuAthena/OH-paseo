+// @vitest-environment jsdom
+import { act, render, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { HarmonyNavigation } from "./harmonyos-navigation";
+import { useWebOverlayRegistration } from "@/lib/overlay-root";
+import { subscribeHarmonyBack } from "@/utils/harmonyos-back";
+
+const nav = vi.hoisted(() => ({
+  pathname: "/open-project",
+  canGoBack: false,
+  compact: false,
+  back: vi.fn(),
+  replace: vi.fn(),
+  showMobileAgent: vi.fn(),
+  target: "agent",
+}));
+vi.mock("expo-router", () => ({
+  useRouter: () => ({ canGoBack: () => nav.canGoBack, back: nav.back, replace: nav.replace }),
+  usePathname: () => nav.pathname,
+}));
+vi.mock("@/constants/platform", () => ({ isHarmonyApp: true, isWeb: true }));
+vi.mock("@/constants/layout", () => ({ useIsCompactFormFactor: () => nav.compact }));
+vi.mock("@/stores/panel-store", () => ({
+  usePanelStore: {
+    getState: () => ({ mobilePanel: { target: nav.target }, showMobileAgent: nav.showMobileAgent }),
+  },
+}));
+
+function back() {
+  const event = new Event("paseo-system-back", { cancelable: true });
+  act(() => {
+    window.dispatchEvent(event);
+  });
+  expect(event.defaultPrevented).toBe(true);
+}
+
+beforeEach(() => {
+  Object.assign(nav, {
+    pathname: "/open-project",
+    canGoBack: false,
+    compact: false,
+    target: "agent",
+  });
+  vi.clearAllMocks();
+});
+afterEach(() => {
+  document.body.replaceChildren();
+});
+
+describe("HarmonyOS system Back", () => {
+  it("returns within router history and consumes Back at the app root", () => {
+    const page = render(<HarmonyNavigation />);
+    back();
+    expect(nav.back).not.toHaveBeenCalled();
+    expect(nav.replace).not.toHaveBeenCalled();
+    nav.canGoBack = true;
+    back();
+    expect(nav.back).toHaveBeenCalledTimes(1);
+    page.unmount();
+  });
+
+  it("closes a painted modal before navigating the underlying page", () => {
+    const page = render(<HarmonyNavigation />);
+    nav.canGoBack = true;
+    const close = vi.fn();
+    const scope = document.createElement("div");
+    document.body.append(scope);
+    const overlay = renderHook(() =>
+      useWebOverlayRegistration({
+        active: true,
+        layer: 20,
+        onKeyDown: () => {
+          close();
+          return true;
+        },
+      }),
+    );
+    act(() => overlay.result.current(scope));
+    back();
+    expect(close).toHaveBeenCalledTimes(1);
+    expect(nav.back).not.toHaveBeenCalled();
+    overlay.unmount();
+    page.unmount();
+  });
+
+  it("offers compact sheet Back to the newest visible sheet first", () => {
+    const page = render(<HarmonyNavigation />);
+    const lower = vi.fn(() => true),
+      upper = vi.fn(() => true);
+    const removeLower = subscribeHarmonyBack(lower),
+      removeUpper = subscribeHarmonyBack(upper);
+    back();
+    expect(upper).toHaveBeenCalledTimes(1);
+    expect(lower).not.toHaveBeenCalled();
+    removeUpper();
+    back();
+    expect(lower).toHaveBeenCalledTimes(1);
+    removeLower();
+    page.unmount();
+  });
+
+  it("closes a compact sidebar before returning a route", () => {
+    Object.assign(nav, { compact: true, target: "agent-list", canGoBack: true });
+    const page = render(<HarmonyNavigation />);
+    back();
+    expect(nav.showMobileAgent).toHaveBeenCalledOnce();
+    expect(nav.back).not.toHaveBeenCalled();
+    page.unmount();
+  });
+
+  it("returns from a cold settings link and removes its listener on unmount", () => {
+    nav.pathname = "/settings/general";
+    const page = render(<HarmonyNavigation />);
+    back();
+    expect(nav.replace).toHaveBeenCalledWith("/open-project");
+    page.unmount();
+    const event = new Event("paseo-system-back", { cancelable: true });
+    window.dispatchEvent(event);
+    expect(event.defaultPrevented).toBe(false);
+  });
+});
