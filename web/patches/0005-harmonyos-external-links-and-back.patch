+const listeners = new Set<() => boolean>();
+
+/** Visible compact sheets subscribe only while on screen, newest first. */
+export function subscribeHarmonyBack(listener: () => boolean): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function dispatchHarmonyBack(): boolean {
+  for (const listener of [...listeners].toReversed()) {
+    if (listener()) return true;
+  }
+  return false;
+}
