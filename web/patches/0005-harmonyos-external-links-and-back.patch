+import { useEffect } from "react";
+import { usePathname, useRouter } from "expo-router";
+import { isHarmonyApp } from "@/constants/platform";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import {
+  dispatchTopWebOverlayKeyDown,
+  hasActiveWebOverlay,
+  hasOpenDomPopover,
+} from "@/lib/overlay-root";
+import { usePanelStore } from "@/stores/panel-store";
+import { dispatchHarmonyBack } from "@/utils/harmonyos-back";
+
+/** One native Back press closes one surface or moves one level within Paseo. */
+export function HarmonyNavigation() {
+  const router = useRouter();
+  const pathname = usePathname();
+  const compact = useIsCompactFormFactor();
+  useEffect(() => {
+    if (!isHarmonyApp) return;
+    const back = (event: Event) => {
+      event.preventDefault();
+      if (hasOpenDomPopover()) {
+        const popovers = document.querySelectorAll<HTMLElement>(":popover-open");
+        popovers[popovers.length - 1]?.hidePopover();
+        return;
+      }
+      if (hasActiveWebOverlay()) {
+        dispatchTopWebOverlayKeyDown(
+          new KeyboardEvent("keydown", { key: "Escape", cancelable: true }),
+        );
+        return;
+      }
+      if (dispatchHarmonyBack()) return;
+      const panels = usePanelStore.getState();
+      if (compact && panels.mobilePanel.target !== "agent") {
+        panels.showMobileAgent();
+        return;
+      }
+      if (router.canGoBack()) {
+        router.back();
+        return;
+      }
+      // Cold settings/scanner deep links have no earlier history entry.
+      if (pathname.startsWith("/settings") || pathname === "/pair-scan")
+        router.replace("/open-project");
+      // At an application root, consume Back; Home remains the way to leave.
+    };
+    window.addEventListener("paseo-system-back", back);
+    return () => window.removeEventListener("paseo-system-back", back);
+  }, [router, pathname, compact]);
+  return null;
+}
