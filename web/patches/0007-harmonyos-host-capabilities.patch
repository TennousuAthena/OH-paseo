 /** Development build/runtime — true in Metro dev bundles, false in production. */
 export const isDev = Boolean((globalThis as { __DEV__?: boolean }).__DEV__);
 
+/** The bundled HarmonyOS host, including PC where scanning is unavailable. */
+export const isHarmonyApp =
+  isWeb &&
+  typeof window !== "undefined" &&
+  (window as Window & { __PASEO_HARMONY_APP__?: boolean }).__PASEO_HARMONY_APP__ === true;
+
+/** Capability injected only into the bundled phone/tablet app by its native host. */
+export const hasHarmonyScanner =
+  isWeb &&
+  typeof window !== "undefined" &&
+  (window as Window & { __PASEO_HARMONY_SCAN__?: boolean }).__PASEO_HARMONY_SCAN__ === true;
+
