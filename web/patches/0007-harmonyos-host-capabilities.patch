+++ b/packages/app/src/constants/platform.test.ts
@@ -0,0 +1,50 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const runtime = vi.hoisted(() => ({ os: "web" }));
+vi.mock("react-native", () => ({
+  Platform: {
+    get OS() {
+      return runtime.os;
+    },
+  },
+}));
+vi.mock("@/desktop/host", () => ({
+  isElectronRuntime: () => false,
+  isElectronRuntimeMac: () => false,
+}));
+
+beforeEach(() => {
+  vi.resetModules();
+  runtime.os = "web";
+});
+
+afterEach(() => {
+  Reflect.deleteProperty(window, "__PASEO_HARMONY_APP__");
+  Reflect.deleteProperty(window, "__PASEO_HARMONY_SCAN__");
+});
+
+describe("HarmonyOS native host capabilities", () => {
+  it("keeps ordinary web clients outside the native host", async () => {
+    const platform = await import("./platform");
+    expect(platform.isHarmonyApp).toBe(false);
+    expect(platform.hasHarmonyScanner).toBe(false);
+  });
+
+  it.each([false, true])("reads the injected scanner capability: %s", async (scanner) => {
+    Object.defineProperty(window, "__PASEO_HARMONY_APP__", { value: true, configurable: true });
+    Object.defineProperty(window, "__PASEO_HARMONY_SCAN__", { value: scanner, configurable: true });
+    const platform = await import("./platform");
+    expect(platform.isHarmonyApp).toBe(true);
+    expect(platform.hasHarmonyScanner).toBe(scanner);
+  });
+
+  it("ignores injected flags outside the web runtime", async () => {
+    runtime.os = "android";
+    Object.defineProperty(window, "__PASEO_HARMONY_APP__", { value: true, configurable: true });
+    Object.defineProperty(window, "__PASEO_HARMONY_SCAN__", { value: true, configurable: true });
+    const platform = await import("./platform");
+    expect(platform.isHarmonyApp).toBe(false);
+    expect(platform.hasHarmonyScanner).toBe(false);
+  });
+});
