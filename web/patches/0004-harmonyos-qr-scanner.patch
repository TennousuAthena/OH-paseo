diff --git a/packages/app/src/utils/harmonyos-scan.ts b/packages/app/src/utils/harmonyos-scan.ts
new file mode 100644
index 000000000..593647900
--- /dev/null
+++ b/packages/app/src/utils/harmonyos-scan.ts
@@ -0,0 +1,38 @@
+import { hasHarmonyScanner } from "@/constants/platform";
+
+interface ScanResult {
+  id: string;
+  value: string;
+  error: string;
+  cancelled: boolean;
+}
+
+/** Native host intercepts this navigation; it never leaves the bundled document. */
+export function requestHarmonyScan(signal: AbortSignal): Promise<string | null> {
+  if (!hasHarmonyScanner) return Promise.reject(new Error("QR scanner unavailable"));
+  return new Promise((resolve, reject) => {
+    const id = crypto.randomUUID();
+    const cleanup = () => {
+      window.removeEventListener("paseo-scan-result", receive);
+      signal.removeEventListener("abort", abort);
+    };
+    const abort = () => {
+      cleanup();
+      resolve(null);
+    };
+    const receive = (event: Event) => {
+      const result = (event as CustomEvent<ScanResult>).detail;
+      if (result?.id !== id) return;
+      cleanup();
+      if (result.error) reject(new Error(result.error));
+      else resolve(result.cancelled ? null : result.value);
+    };
+    if (signal.aborted) {
+      resolve(null);
+      return;
+    }
+    window.addEventListener("paseo-scan-result", receive);
+    signal.addEventListener("abort", abort, { once: true });
+    window.location.assign(`paseo://app/__native/scan?id=${id}`);
+  });
+}
